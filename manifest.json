{
    "name": "Page Element Modifier",
    "description": "Used to remove any element from any page, typically ads.",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
        "default_popup": "info.html",
        "default_icon": "thumbnail.png"
    },
    "content_scripts": [
        {
          "matches": ["<all_urls>"],
          "js": ["jquery-3.7.1.min.js", "listener.js"]
        }
      ],
      "background": {
        "service_worker": "background.js",
        "type": "module"
      },
    "permissions": ["tabs","activeTab","scripting","contextMenus"]
}
  